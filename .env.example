# Public URL used by browsers, emails and the Windows client.
APP_URL=https://projektzeit.example.de

# Host port for the ProjektZeit container.
APP_PORT=8080

# Long random secret used to protect server-side secrets and sessions.
APP_SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL database name.
DB_NAME=projektzeit

# PostgreSQL database user.
DB_USER=projektzeit

# PostgreSQL database password.
DB_PASSWORD=change-me

# First name of the initial administrator. Used only when the database is empty.
BOOTSTRAP_ADMIN_FIRST_NAME=Tobias

# Last name of the initial administrator.
BOOTSTRAP_ADMIN_LAST_NAME=Friedrichsen

# Login email of the initial administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.de

# Initial administrator password. Change it after the first login and remove it from the environment afterwards.
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-start

# Image tag to deploy. Use a fixed release tag in production instead of latest.
PROJEKTZEIT_VERSION=1.0.3
